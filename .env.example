# ==============================================================================
# I.SEE AGENTS — MULTI-AGENT AI PLATFORM CONFIGURATION
# Developer: Júlio César | I.See Technologies (https://iseetechnologies.com.br/)
# ==============================================================================

# Application
APP_NAME="I.See Agents — Multi-Agent AI Platform"
APP_VERSION="2.0.0"
APP_ENV="development"
DEBUG=false

# Security & Authentication (REPLACE IN PRODUCTION)
SECRET_KEY="CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL + pgvector recommended for production; SQLite supported for local fallback/testing)
# Production Docker / Debian example:
# DATABASE_URL="postgresql+psycopg://isee_admin:isee_secure_pass@localhost:5432/isee_agents"
DATABASE_URL="sqlite:///./isee_agents.db"

# AI Providers & Ollama Integration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3.2:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=60
ALLOW_DEMO_FALLBACK=true

# RAG & Knowledge Base Security
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=15
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
EMBEDDING_DIMENSION=384

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
